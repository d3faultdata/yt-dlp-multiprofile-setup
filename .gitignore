# =========================================================
# Binaries and runtime tools (downloaded separately, never committed)
# =========================================================
*.exe
*.dll
*.zip
*.pyd
_internal/
yt_dlp_plugins/

# Linux/macOS binaries (extensionless). Anchored to the repo root so they do
# not shadow the committed "dlp" launcher script or dlp.py.
/yt-dlp
/ffmpeg
/ffprobe
/AtomicParsley
/fpcalc

# =========================================================
# Local per-machine settings (holds your personal media path)
# =========================================================
dlp.local.conf

# Filled-in test scripts (your personal test URLs). Keep only the .example
# templates in git.
test-profiles.ps1
test-profiles.sh

# =========================================================
# yt-dlp runtime state (download history, etc.)
# =========================================================
yt_dlp_archives/

# =========================================================
# Secrets: never commit cookies or auth data
# =========================================================
cookies.txt
*.cookies
*cookies*.txt

# =========================================================
# Media files
# =========================================================
*.m4a
*.mp3
*.flac
*.wav
*.aac
*.ogg
*.opus
*.mp4
*.mkv
*.webm
*.webp
*.jpg
*.jpeg
*.png

# =========================================================
# Old / backup snapshots and temp folders
# =========================================================
_old/
old/
txt/
tmp/
ffmpeg-unpacked/
*_backup.*
*_old.*
