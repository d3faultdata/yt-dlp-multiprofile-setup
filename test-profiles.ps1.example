# test-profiles.ps1 - smoke-test every profile with one download each (Windows).
#
# Setup:
#   1. Copy this file to "test-profiles.ps1"
#   2. Replace each XXXX with a real URL of the matching type (and your own
#      SoundCloud likes URL for sc-likes).
#   3. Run from inside the repo folder:
#        powershell -ExecutionPolicy Bypass -File test-profiles.ps1
#
# Your filled-in "test-profiles.ps1" is git-ignored, so personal URLs stay local.
# Multi-item profiles (playlists / albums / channels) are limited to 1 file each.

$tests = [ordered]@{
  # --- audio ---
  'yt-playlist-audio' = 'https://www.youtube.com/playlist?list=XXXX'
  'yt-album'          = 'https://music.youtube.com/playlist?list=OLAK5uy_XXXX'
  'yt-single'         = 'https://music.youtube.com/watch?v=XXXX'
  'yt-podcasts'       = 'https://www.youtube.com/watch?v=XXXX'
  'sc-likes'          = 'https://soundcloud.com/YOURUSER/likes'
  'yt-channel-audio'  = 'https://www.youtube.com/@SomeChannel'
  # --- video ---
  'yt-video'          = 'https://www.youtube.com/watch?v=XXXX'
  'yt-playlist-video' = 'https://www.youtube.com/playlist?list=XXXX'
  'yt-channel-video'  = 'https://www.youtube.com/@SomeChannel'
}
$multi = 'yt-playlist-audio','yt-playlist-video','yt-album','yt-podcasts','sc-likes','yt-channel-audio','yt-channel-video'

$passed = @(); $failed = @()
foreach ($p in $tests.Keys) {
  $extra = @(); if ($multi -contains $p) { $extra = @('--playlist-items','1') }
  Write-Host "==================== $p ====================" -ForegroundColor Cyan
  & .\dlp.cmd $p $tests[$p] @extra
  if ($LASTEXITCODE -eq 0) { $passed += $p } else { $failed += $p }
}
Write-Host "========================================"
Write-Host "PASSED: $($passed -join ' ')" -ForegroundColor Green
Write-Host "FAILED: $($failed -join ' ')" -ForegroundColor Red
